<?xml version="1.0" encoding="UTF-8"?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
  <name>PushNotification</name>
  <description>Send push notifications (e.g. to your phone via ntfy) when FreeCAD saves a document, hits an error, or finishes a long-running task such as a render, export, FEM analysis, or simulation.</description>
  <version>1.1.0</version>
  <date>2026-08-21</date>
  <maintainer email="laffranchi.marco@gmail.com">Marco Laffranchi</maintainer>
  <license file="LICENSE">GPL-3.0-or-later</license>
  <url type="repository" branch="main">https://github.com/mlaffran/PushNotification.git</url>
  <url type="bugtracker">https://github.com/mlaffran/PushNotification/issues</url>
  <url type="readme">https://github.com/mlaffran/PushNotification/blob/main/README.md</url>
  <icon>resources/push_notification_icon.svg</icon>
  <freecadmin>1.1</freecadmin>
  <pythonmin>3.10</pythonmin>
  <content>
    <workbench>
      <classname>PushNotificationWorkbench</classname>
      <subdirectory>.</subdirectory>
      <depend optional="True" type="automatic">keyring</depend>
    </workbench>
  </content>
  <tag>notification</tag>
  <tag>automation</tag>
  <tag>ntfy</tag>
</package>
